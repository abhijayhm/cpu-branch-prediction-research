# Local simulator tree (cloned at the pinned commit; not vendored)
champsim/ChampSim/

# Large traces — metadata only is committed
data/traces/*
!data/traces/.gitkeep
!data/traces/README.md

# Extracted branch logs can be large
data/extracted/*
!data/extracted/.gitkeep

# Generated ChampSim configs / binaries
champsim/generated/
champsim/bin/

# Local experiment dumps
results/raw/*
!results/raw/.gitkeep
results/tmp/

# Trained weights (export artifacts that are small may be committed under models/export)
models/*.pt
models/*.pth
models/checkpoints/
*.onnx

# Python / build
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
build/
dist/
.mypy_cache/
.ruff_cache/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Docker / conda leftovers
.conda/
